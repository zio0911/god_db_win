  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\GodDB.Core\GodDB.Core.csproj" />
    <ProjectReference Include="..\..\src\GodDB.App\GodDB.App.csproj" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>
</Project>
