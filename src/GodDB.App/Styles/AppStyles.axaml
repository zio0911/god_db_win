<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:GodDB.App.Controls">
  <!-- Mac ButtonStyles.swift · AdaptiveBar.swift 에 해당하는 공용 모양 -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SecondaryText" Color="#8A8A8E"/>
          <SolidColorBrush x:Key="TertiaryText" Color="#B0B0B5"/>
          <SolidColorBrush x:Key="BarBackground" Color="#F2F2F4"/>
          <SolidColorBrush x:Key="PanelBackground" Color="#FAFAFB"/>
          <SolidColorBrush x:Key="DividerBrush" Color="#DDDDE0"/>
          <SolidColorBrush x:Key="SelectionBackground" Color="#260A84FF"/>
          <SolidColorBrush x:Key="CodeBackground" Color="#FFFFFF"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SecondaryText" Color="#98989D"/>
          <SolidColorBrush x:Key="TertiaryText" Color="#6C6C70"/>
          <SolidColorBrush x:Key="BarBackground" Color="#2A2A2D"/>
          <SolidColorBrush x:Key="PanelBackground" Color="#232326"/>
          <SolidColorBrush x:Key="DividerBrush" Color="#3A3A3D"/>
          <SolidColorBrush x:Key="SelectionBackground" Color="#330A84FF"/>
          <SolidColorBrush x:Key="CodeBackground" Color="#1C1C1E"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="GreenBrush" Color="#34C759"/>
      <SolidColorBrush x:Key="OrangeBrush" Color="#FF9500"/>
      <SolidColorBrush x:Key="RedBrush" Color="#FF3B30"/>
      <SolidColorBrush x:Key="PurpleBrush" Color="#AF52DE"/>
      <SolidColorBrush x:Key="BlueBrush" Color="#0A84FF"/>
      <SolidColorBrush x:Key="YellowBrush" Color="#FFCC00"/>
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- 마우스를 올리면 배경이 생기고, 누르면 진해지며 살짝 작아지는 버튼 (HoverButtonStyle) -->
  <Style Selector="Button.hover">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.06"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.hover:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#290A84FF"/>
    <Setter Property="BorderBrush" Value="#730A84FF"/>
    <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
  </Style>
  <Style Selector="Button.hover:pressed">
    <Setter Property="RenderTransform" Value="scale(0.93)"/>
  </Style>
  <Style Selector="Button.hover:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#520A84FF"/>
  </Style>
  <Style Selector="Button.hover:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- 테두리 없는 아이콘 버튼 (Mac .borderless) -->
  <Style Selector="Button.borderless">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="4,2"/>
    <Setter Property="MinWidth" Value="0"/>
  </Style>
  <Style Selector="Button.borderless:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1A808080"/>
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
  </Style>

  <Style Selector="TextBlock.secondary, SelectableTextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
  </Style>
  <!-- 회색 아이콘 (Mac .foregroundStyle(.secondary)) / 강조색 아이콘 -->
  <Style Selector="c|SymbolIcon.secondary">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
  </Style>
  <Style Selector="c|SymbolIcon.accent">
    <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
  </Style>
  <Style Selector="TextBlock.caption, SelectableTextBlock.caption">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.headline">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.error, SelectableTextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
  </Style>
  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
  </Style>

  <!-- 작은 표시 (MY / PG, 읽기전용, SSH, 환경) -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Padding" Value="3,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="9"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
  </Style>
  <Style Selector="Border.section">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12"/>
  </Style>

  <!-- 도구 막대: 자리가 모자라면 아이콘만 (AdaptiveBar) -->
  <Style Selector="ScrollViewer.adaptiveBar:compact :is(Control).label">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
</Styles>
