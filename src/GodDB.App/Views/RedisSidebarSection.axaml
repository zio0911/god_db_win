<!-- 사이드바 Redis 영역: DB 선택 · 트리/목록 · 자동 새로고침 · 키 트리. DataContext = RedisWorkspace (없으면 null) — Mac RedisSidebarSection -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GodDB.App.ViewModels"
             xmlns:l="using:GodDB.App.Infrastructure"
             x:Class="GodDB.App.Views.RedisSidebarSection"
             x:DataType="vm:RedisWorkspace">
  <UserControl.Styles>
    <Style Selector="Border.keyRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.keyRow:pointerover">
      <Setter Property="Background" Value="#14808080"/>
    </Style>
    <Style Selector="Border.keyRow.selected">
      <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
    </Style>
    <Style Selector="ToggleButton.seg">
      <Setter Property="Padding" Value="6,1"/>
      <Setter Property="MinWidth" Value="26"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </UserControl.Styles>
  <StackPanel Margin="0,10,0,0" Spacing="4">
    <!-- DB · 키 수 · 새 키 -->
    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6" Margin="2,0,0,0">
      <TextBlock Text="DB" Classes="secondary" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="1" x:Name="DbBox" ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}" Padding="6,2" MinWidth="70">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RedisDbItem">
            <TextBlock Text="{Binding Title}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Column="3" Text="{Binding KeyCountText}" Classes="secondary" VerticalAlignment="Center" FontSize="12"/>
      <Button Grid.Column="4" Classes="borderless" x:Name="NewKeyButton" Content="＋" ToolTip.Tip="{l:T 새 키}" IsEnabled="{Binding CanWrite}"/>
    </Grid>
    <!-- 트리/목록 · 구분자 · 새로고침 · 자동 새로고침 -->
    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="4" Margin="2,0,0,2">
      <StackPanel Orientation="Horizontal" Spacing="0" ToolTip.Tip="{l:T '트리 / 목록 보기'}">
        <ToggleButton Classes="seg" x:Name="TreeButton" Padding="6,3" IsChecked="{Binding TreeMode, Mode=OneWay}" ToolTip.Tip="{l:T 트리}"/>
        <ToggleButton Classes="seg" x:Name="ListButton" Padding="6,3" IsChecked="{Binding !TreeMode, Mode=OneWay}" ToolTip.Tip="{l:T 목록}"/>
      </StackPanel>
      <Button Grid.Column="1" Classes="borderless" x:Name="DelimiterButton" Content="{Binding Delimiter}" FontFamily="{StaticResource MonoFont}"
              IsVisible="{Binding TreeMode}" ToolTip.Tip="{l:T '폴더 구분자, 모두 펼치기/접기'}"/>
      <Button Grid.Column="3" Classes="borderless" x:Name="RefreshButton" Padding="6,4" ToolTip.Tip="{l:T '새로고침 (키 목록, TTL, 열린 값)'}"/>
      <ToggleButton Grid.Column="4" Classes="seg" x:Name="AutoButton" Padding="6,3" IsChecked="{Binding AutoRefresh, Mode=OneWay}"
                    ToolTip.Tip="{l:T '자동 새로고침 켜기/끄기'}"/>
      <TextBox Grid.Column="5" x:Name="SecondsBox" Width="42" MinWidth="42" MinHeight="24" Height="24" Padding="4,0" TextAlignment="Right"
               VerticalContentAlignment="Center" VerticalAlignment="Center" FontSize="12" Margin="4,0,0,0"
               ToolTip.Tip="{l:T '자동 새로고침 간격 (초, 1~3600)'}"/>
      <TextBlock Grid.Column="6" Text="{l:T 초}" Classes="secondary" VerticalAlignment="Center" FontSize="12" Margin="4,0,0,0"/>
    </Grid>

    <TextBlock Text="{l:T 키 불러오는 중…}" Classes="secondary" FontSize="12" Margin="4,2" IsVisible="{Binding ShowLoadingKeys}"/>

    <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:RedisKeyRowItem">
          <Border Classes="keyRow" Classes.selected="{Binding Selected}" ToolTip.Tip="{Binding Tip}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="{Binding Indent}">
              <!-- 폴더: ▸ 📁 -->
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsFolder}">
                <TextBlock Text="{Binding Chevron}" Classes="secondary" Width="8" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="📁" FontSize="11" VerticalAlignment="Center"/>
              </StackPanel>
              <!-- 키: 타입 배지 (아직 모르면 🔑) -->
              <Panel IsVisible="{Binding IsKey}" Width="18" VerticalAlignment="Center">
                <Border IsVisible="{Binding HasMeta}" Background="{Binding TypeBackground}" CornerRadius="3" Height="14" ToolTip.Tip="{Binding TypeName}">
                  <TextBlock Text="{Binding TypeLetter}" Foreground="{Binding TypeBrush}" FontSize="9" FontWeight="Bold"
                             FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock IsVisible="{Binding !HasMeta}" Text="🔑" FontSize="9" Classes="secondary" HorizontalAlignment="Center"/>
              </Panel>
              <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         Classes.secondary="{Binding IsEmptyLabel}" Classes.missing="{Binding Missing}"/>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock IsVisible="{Binding IsFolder}" Text="{Binding CountText}" Classes="secondary" FontSize="11"/>
                <TextBlock Text="{Binding TtlText}" FontSize="10" Classes="secondary" Classes.soon="{Binding TtlSoon}" ToolTip.Tip="{Binding TtlTip}"/>
                <TextBlock IsVisible="{Binding Expired}" Text="{l:T 만료됨}" FontSize="10" Foreground="{DynamicResource RedBrush}"/>
              </Panel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      <ItemsControl.Styles>
        <Style Selector="TextBlock.soon">
          <Setter Property="Foreground" Value="{DynamicResource OrangeBrush}"/>
        </Style>
        <Style Selector="TextBlock.missing">
          <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
          <Setter Property="TextDecorations" Value="Strikethrough"/>
        </Style>
      </ItemsControl.Styles>
    </ItemsControl>

    <Button Classes="link" x:Name="MoreButton" Content="{Binding MoreKeysText}" IsVisible="{Binding HasMoreKeys}"
            IsEnabled="{Binding !LoadingKeys}" Margin="4,2"/>
    <TextBlock Text="{Binding AllCountText}" Classes="caption" Margin="4,2" IsVisible="{Binding ShowAllCount}"/>
    <TextBlock Text="{l:T 맞는 키가 없어요.}" Classes="caption" Margin="4,2" IsVisible="{Binding ShowNoKeys}"/>
  </StackPanel>
</UserControl>
