<!-- 모델링 화면 (모델링 포팅에서 바꾼다). DataContext = AppState -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GodDB.App.ViewModels"
             x:Class="GodDB.App.Views.ModelingView"
             x:DataType="vm:AppState">
  <TextBlock Text="모델링 (작업 중)" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="secondary"/>
</UserControl>
