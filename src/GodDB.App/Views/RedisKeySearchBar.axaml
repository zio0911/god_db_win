<!-- 사이드바 아래 Redis 키 검색 (패턴 + 타입). DataContext = RedisWorkspace (없으면 null) — Mac RedisKeySearchBar -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GodDB.App.ViewModels"
             xmlns:l="using:GodDB.App.Infrastructure"
             x:Class="GodDB.App.Views.RedisKeySearchBar"
             x:DataType="vm:RedisWorkspace">
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="8,6"
        ToolTip.Tip="{l:T 'SCAN MATCH 패턴. * 는 아무 글자, ? 는 한 글자. Enter 로 검색'}">
    <TextBlock Text="🔍" Classes="secondary" VerticalAlignment="Center"/>
    <TextBox Grid.Column="1" x:Name="PatternBox" Text="{Binding Pattern}" PlaceholderText="{l:T '키 패턴 (예: user:*)'}"
             BorderThickness="0" Background="Transparent"/>
    <ComboBox Grid.Column="2" x:Name="TypeBox" Padding="6,2" MinWidth="90"/>
  </Grid>
</UserControl>
