<!-- 상태창: 접속·쿼리·스키마·비교 이벤트와 오류 상세 (Mac LogPanelView) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GodDB.App.ViewModels"
             xmlns:l="using:GodDB.App.Infrastructure"
             xmlns:audit="using:GodDB.Core.Audit"
             x:Class="GodDB.App.Views.LogPanelView"
             x:DataType="vm:AppState"
             Background="{DynamicResource PanelBackground}">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,4">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <TextBlock Classes="headline" Text="{l:T 상태창}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <CheckBox Grid.Column="1" x:Name="ErrorsOnly" Content="{l:T 오류만}"/>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
          <Button Classes="borderless" x:Name="CopyAll" Content="{l:T 전체 복사}"/>
          <Button Classes="borderless" x:Name="LogFolder" Content="{l:T 로그 폴더}"/>
          <Button Classes="borderless" x:Name="Report" Content="{l:T 문제 보고}" ToolTip.Tip="{l:T '오류·크래시 정보를 담아 GitHub 이슈로 보고해요'}"/>
          <Button Classes="borderless" x:Name="Clear" Content="{l:T 지우기}"/>
          <Button Classes="borderless" x:Name="CloseButton" Content="✕" ToolTip.Tip="{l:T 닫기}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Panel>
      <TextBlock x:Name="EmptyText" Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Grid x:Name="Body" ColumnDefinitions="*,4,380">
        <ListBox x:Name="List" SelectionMode="Single" Background="Transparent">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,2"/>
              <Setter Property="MinHeight" Value="22"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="audit:LogEntry">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Date, Converter={x:Static l:Conv.Time}}" Classes="secondary mono" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Level, Converter={x:Static l:Conv.LevelIcon}}" Foreground="{Binding Level, Converter={x:Static l:Conv.LevelBrush}}" VerticalAlignment="Center"/>
                <Border Background="#1F808080" CornerRadius="4" Padding="5,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Source, Converter={x:Static l:Conv.Title}}" FontSize="11"/>
                </Border>
                <TextBlock Text="{Binding Message}" Classes.error="{Binding Level, Converter={x:Static l:Conv.IsError}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource DividerBrush}"/>
        <ScrollViewer Grid.Column="2" x:Name="DetailScroll">
          <StackPanel Margin="10" Spacing="10" x:Name="Detail"/>
        </ScrollViewer>
      </Grid>
    </Panel>
  </DockPanel>
</UserControl>
